# The catch-all must come FIRST. Git applies the last matching line per attribute, so a
# trailing `* text=auto` overrides the binary rules below and subjects PDFs and images to
# line-ending conversion on checkout, changing their bytes.
* text=auto

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
